---
import type { MarkdownHeading } from "astro";
import { isPostsPath } from "../../utils/url-utils";
import Announcement from "./Announcement.astro";
import CardTOC from "./CardTOC.astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const { class: className, headings } = Astro.props;
const isPostsRoute = isPostsPath(Astro.url.pathname);
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class:list={[
        "flex flex-col w-full gap-4 mb-4 transition-all duration-700",
        !isPostsRoute && "top-4 sticky top-4",
    ]}>
        <Announcement class="onload-animation" style="animation-delay: 100ms"></Announcement>
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
    </div>
    <CardTOC headings={headings} class="onload-animation" style="animation-delay: 250ms"></CardTOC>
</div>

<script>
	import { isPostsPath } from "../../utils/url-utils";

	let swupHooked = false;

	function setSidebarSticky(sticky: boolean) {
		const sidebarSticky = document.getElementById("sidebar-sticky");
		if (!sidebarSticky) return;

		sidebarSticky.classList.toggle("sticky", sticky);
		sidebarSticky.classList.toggle("top-4", sticky);
	}

	function updateSidebarSticky() {
		setSidebarSticky(!isPostsPath(window.location.pathname));
	}

	function setupSwupHooks() {
		if (swupHooked || !window.swup) return;
		swupHooked = true;

		// 在 page:view 时同步切换，此时 Swup 已完成滚动复位，
		// 避免在旧页面滚动位置移除 sticky 导致侧边栏瞬间上移。
		window.swup.hooks.on("page:view", updateSidebarSticky);
	}

	if (window.swup) {
		setupSwupHooks();
	} else {
		document.addEventListener("swup:enable", setupSwupHooks);
	}
</script>
